{
    "name": "api",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsup",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "backfill:actress-count": "tsx src/scripts/backfill-actress-count.ts",
        "search:sync": "tsx src/scripts/sync-viewer-search.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1123.0",
        "@workspace/auth": "workspace:*",
        "@workspace/core": "workspace:*",
        "@workspace/db": "workspace:*",
        "@workspace/media": "workspace:*",
        "better-auth": "^1.6.29",
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "5.2.1",
        "file-type": "^20.5.0",
        "mongodb": "7.5.0",
        "mongoose": "9.7.4",
        "multer": "^2.3.0",
        "sharp": "^0.34.5"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.2.0",
        "@types/node": "^20",
        "tsup": "^8.5.1",
